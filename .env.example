# Database
POSTGRES_USER=gasto
POSTGRES_PASSWORD=gasto_dev_change_me
POSTGRES_DB=gasto_abierto
# Inside Docker use hostnames; from host machine use localhost:5434
DATABASE_URL=postgresql+psycopg://gasto:gasto_dev_change_me@postgres:5432/gasto_abierto

# Redis / ARQ
REDIS_URL=redis://redis:6379/0

# MinIO (S3-compatible raw lake)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=gasto-raw
MINIO_PUBLIC_URL=http://localhost:9010
MINIO_ENABLED=0
# MINIO_CONNECT_TIMEOUT_SECONDS=5  — fail-fast si MinIO apagado (default 5s)
# Para raw lake: MINIO_ENABLED=1 y docker compose --profile storage up -d
MINIO_SECURE=0

# API (bind interno; host network usa API_HOST + API_PORT en entrypoint)
API_HOST=0.0.0.0
API_PORT=8000
# Host port mapping (docker compose): ${API_HOST_PORT:-8010}:${API_PORT:-8000}
API_HOST_PORT=8010
WEB_HOST_PORT=3010
POSTGRES_HOST_PORT=5434  # pragma: allowlist secret
REDIS_HOST_PORT=6380  # pragma: allowlist secret
MINIO_API_HOST_PORT=9010
MINIO_CONSOLE_HOST_PORT=9011
CORS_ORIGINS=http://localhost:3010,http://127.0.0.1:3010
RATE_LIMIT_PER_MINUTE=120

# Worker / scrapers
SCRAPE_RATE_LIMIT_RPS=1.0
# SICOES resilience (Wave 4)
# SICOES_FETCH_MIN_BYTES=256
# SICOES_RETRY_BACKOFF_SEC=1.5
# PLAYWRIGHT_TIMEOUT_MS=60000
# PLAYWRIGHT_RETRIES=2
# Live SICOES: pages per year (not just first page)
SICOES_MAX_PAGES=25
# Optional: SICOES_YEARS=2019,2020,2021,2022,2023,2024,2025
SICOES_YEARS=
# AGETIC: comma-separated CKAN package ids; empty = defaults + package_search when live
AGETIC_PACKAGE_IDS=
AGETIC_MAX_RESOURCES=50
AGETIC_SEARCH_ROWS=25
LIVE_SCRAPE=0

# Proxy / VPN (OBLIGATORIO para LIVE_SCRAPE=1)
# Cualquier scrape en vivo (SICOES, descarga remota Presupuesto Abierto) requiere proxy.
# Usá tu cliente VPN/proxy local; en Docker Desktop suele ser host.docker.internal
# Ejemplos:
#   PROXY_URL=http://127.0.0.1:7890
#   PROXY_URL=http://host.docker.internal:7890
#   HTTPS_PROXY=socks5://127.0.0.1:1080
PROXY_URL=
HTTPS_PROXY=
HTTP_PROXY=
REQUIRE_PROXY_FOR_LIVE=1
HTTP_TIMEOUT_SECONDS=60
HTTP_USER_AGENT=GastoAbiertoBO/0.3 (+research; respectful crawler)

# Presupuesto Abierto — descargas oficiales CSV/Parquet (preferido sobre scraping)
# Vacío = descubrimiento automático desde /descargas (Parquet developer URLs).
# Cuando vacío en CI/staging, usar seed offline:
#   python -m scripts.cli gasto seed --profile presupuesto_corpus
# Para fijar manualmente, copiá URLs directas .csv o .parquet separadas por coma:
# PRESUPUESTO_ABIERTO_DOWNLOAD_URLS=https://abierto.economiayfinanzas.gob.bo/presupuesto/descargas/gasto/ultimo/gasto.parquet
# 1) gasto fetch-presupuesto --list-only
# 2) LIVE_SCRAPE=1 PROXY_URL=... gasto fetch-presupuesto --force
# 3) gasto ingest --source presupuesto_abierto --sync
PRESUPUESTO_ABIERTO_DOWNLOAD_URLS=
# Alias legacy (misma semántica que DOWNLOAD_URLS)
PRESUPUESTO_ABIERTO_URLS=

# Seeds offline — ahorro de RAM en Docker (~512MB)
# SEED_SKIP_STORAGE=1          — no escribir raw a MinIO durante seed (default en contenedor)
# SEED_SKIP_ALERTS_DURING_INGEST=1 — alertas solo al final del profile
# SEED_BATCH_SIZE=25           — commits por lote en profile history
# SEED_TIMEOUT_SECONDS=600       — abortar seed colgado (Unix)
# LOW_DOCKER_RAM=1 HOST_SEED_HISTORY=1 — usar scripts/host_seed_history.sh antes de verify
# BOOT_FULL_SEED=1             — history + cross en arranque API (lento; default off)
# BOOT_PUBLISH_SEED=1          — profile publish (product-gate + incendios) en arranque (muy lento)

# Web (browser calls host-mapped API port)
NEXT_PUBLIC_API_URL=http://localhost:8010
