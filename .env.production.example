# Gasto Abierto — plantilla de entorno para VPS / producción
# Copiar a .env en el servidor. Credenciales DB en vault — ver docs/PRODUCTION/vps-deploy.md

PUBLIC_WEB_URL=https://gasto.ejemplo.bo
PUBLIC_API_URL=https://api.gasto.ejemplo.bo
NEXT_PUBLIC_API_URL=https://api.gasto.ejemplo.bo
CORS_ORIGINS=https://gasto.ejemplo.bo

API_HOST=0.0.0.0
API_PORT=8000
API_HOST_PORT=8010
WEB_HOST_PORT=3010
DB_HOST_PORT=5434  # pragma: allowlist secret
CACHE_HOST_PORT=6380  # pragma: allowlist secret

REDIS_URL=redis://redis:6379/0

MINIO_ENABLED=0
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=gasto-raw
MINIO_PUBLIC_URL=https://storage.gasto.ejemplo.bo
MINIO_SECURE=1

LIVE_SCRAPE=0
REQUIRE_PROXY_FOR_LIVE=1
PROXY_URL=

PRESUPUESTO_ABIERTO_DOWNLOAD_URLS=
RATE_LIMIT_PER_MINUTE=120
